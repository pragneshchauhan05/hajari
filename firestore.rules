rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Workers Rules Block: Strictly isolated per user
    match /workers/{workerId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && isValidId(workerId)
        && (request.resource.data.userId == request.auth.uid || (request.auth.token.email != null && request.resource.data.userEmail == request.auth.token.email))
        && request.resource.data.name is string 
        && request.resource.data.name.size() <= 150
        && request.resource.data.village is string 
        && request.resource.data.village.size() <= 200
        && request.resource.data.dailyWage is number
        && request.resource.data.dailyWage >= 0
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() <= 20;

      allow update: if isSignedIn() && isValidId(workerId)
        && (resource.data.userId == request.auth.uid || (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email))
        && request.resource.data.name is string 
        && request.resource.data.name.size() <= 150
        && request.resource.data.village is string 
        && request.resource.data.village.size() <= 200
        && request.resource.data.dailyWage is number
        && request.resource.data.dailyWage >= 0
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() <= 20;

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)
      );
    }

    // 3. Attendance Rules Block: Strictly isolated per user
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && isValidId(attendanceId)
        && (request.resource.data.userId == request.auth.uid || (request.auth.token.email != null && request.resource.data.userEmail == request.auth.token.email))
        && request.resource.data.workerId is string
        && request.resource.data.year is number
        && request.resource.data.month is number
        && request.resource.data.records is map;

      allow update: if isSignedIn() && isValidId(attendanceId)
        && (resource.data.userId == request.auth.uid || (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email))
        && request.resource.data.workerId is string
        && request.resource.data.year is number
        && request.resource.data.month is number
        && request.resource.data.records is map;

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)
      );
    }
  }
}
